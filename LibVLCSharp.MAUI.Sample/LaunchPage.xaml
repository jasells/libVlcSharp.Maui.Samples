<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LibVLCSharp.MAUI.Sample.LaunchPage"
             Title="LaunchPage">
    <VerticalStackLayout>
        <Label Text="Samples"/>
        <Button 
            Text="Go to VideoView"
            Clicked="OnGoToMainPageClicked"
            VerticalOptions="CenterAndExpand" 
            HorizontalOptions="CenterAndExpand" />
        <Button
            Text="Go to MediaElement"
            Clicked="OnGoToMediaElementPageClicked"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand" />
        <Button
            x:Name="StressBtn"
            Text="Run dispose-race stress (#659)"
            Clicked="OnRunStressClicked"
            VerticalOptions="CenterAndExpand"
            HorizontalOptions="CenterAndExpand" />
        <Label
            x:Name="StressStatus"
            Text=""
            HorizontalOptions="CenterAndExpand" />
    </VerticalStackLayout>
</ContentPage>